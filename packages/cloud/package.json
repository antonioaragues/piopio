    "@piopio/protocol": "workspace:*",
    "@piopio/runtime": "workspace:*",
    "agents": "0.30.1",
    "typebox": "1.3.27"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261016.1",
    "miniflare": "5.20261012.1-beta",
    "wrangler": "4.151.1"
