<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Background mode (docs/spec/02-architecture §3.3): registered with SMAppService.agent from Settings › Engines. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>app.piopio.engine</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/piopio-engine</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>app.piopio.Piopio</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Restart after a crash, not after a clean shutdown. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
</dict>
</plist>
