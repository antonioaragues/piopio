<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Team-signed development builds (Signing.local.xcconfig): the app's own keychain access group, so secrets go
     to the data protection keychain without password prompts. Xcode adds the provisioning profile it requires.
     Release builds get the same group from scripts/release.sh. -->
<plist version="1.0">
<dict>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.piopio.Piopio</string>
	</array>
</dict>
</plist>
